*.rar export-ignore
*.7z export-ignore
*.tar export-ignore
*.tgz export-ignore
*.gz export-ignore
*.bz2 export-ignore
*.xz export-ignore
*.zst export-ignore
*.tmp export-ignore
*.temp export-ignore
*.orig export-ignore
*.rej export-ignore
*.swp export-ignore
*~ export-ignore
/storage/app/system-file-backups export-ignore
/public/uploads export-ignore
/public/storage export-ignore

