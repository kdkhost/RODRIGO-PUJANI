* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php
database/migrations/2026_05_04_150000_create_modulos_table.php whitespace=-blank-at-eof

# Metadados e ferramentas somente de desenvolvimento
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.githooks export-ignore
/.styleci.yml export-ignore
/phpunit.xml export-ignore
/tests export-ignore
/tools export-ignore
/scripts export-ignore
/node_modules export-ignore
/vendor export-ignore

# Documentação Markdown não utilizada em runtime
/CHANGELOG.md export-ignore
/DOCUMENTATION.md export-ignore
/README.md export-ignore
/docs export-ignore

# Ambiente, caches e artefatos locais ou sensíveis
/.env export-ignore
